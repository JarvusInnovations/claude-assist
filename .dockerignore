# Ignore everything by default
*

# Root config files needed for bun workspace
!package.json
!bun.lock
!tsconfig.json

# packages/core
!packages/core/package.json
!packages/core/tsconfig.json
!packages/core/src/**

# packages/chat
!packages/chat/package.json
!packages/chat/tsconfig.json
!packages/chat/src/**

# packages/sessions
!packages/sessions/package.json
!packages/sessions/tsconfig.json
!packages/sessions/src/**
!packages/sessions/migrations/
!packages/sessions/migrations/**

# packages/google
!packages/google/package.json
!packages/google/tsconfig.json
!packages/google/src/**
!packages/google/migrations/
!packages/google/migrations/**

# apps/server
!apps/server/package.json
!apps/server/tsconfig.json
!apps/server/src/**

# apps/admin (frontend)
!apps/admin/package.json
!apps/admin/tsconfig.json
!apps/admin/components.json
!apps/admin/postcss.config.js
!apps/admin/public/
!apps/admin/public/**
!apps/admin/src/
!apps/admin/src/**
