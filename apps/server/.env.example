# Server
PORT=2529
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://claude:dev@localhost:2528/claude_assist
# DISABLE_MIGRATIONS=true  # Skip running migrations on startup

# Module enablement (true by default, set to 'false' to disable)
# ENABLE_SESSIONS=true
# ENABLE_GOOGLE=true

# Master sync disable - overrides all individual sync disable flags
# DISABLE_SYNCS=true

# Session scanning (optional)
# SESSIONS_ORIGINAL_CLAUDE_DIR=/Users/chris/.claude  # Docker path translation
# SESSIONS_MIN_FILE_SIZE=500
# SESSIONS_DISABLE_LOCAL_INGEST=true       # Disable filesystem scanning (push API still works)
# SESSIONS_DISABLE_GENERATE_OUTLINES=true  # Disable AI outline generation
# Suppress automated/noise sessions from ingest by transcript content.
# Newline-separated substrings, appended to built-in defaults (e.g. M87 triage runner).
# SESSIONS_IGNORE_MARKERS="You are triaging a local-first M87 review item.\nAnother marker"

# Session classification (self-improvement loop; needs ANTHROPIC_API_KEY)
# Per-session incremental cursors → append-only Haiku classification events →
# weekly Sonnet synthesis + timeline narrative (delivered via the notify digest).
# SESSIONS_DISABLE_CLASSIFICATION=true      # Disable classification + synthesis
# SESSIONS_CLASSIFICATION_CONCURRENCY=3
# SESSIONS_CLASSIFICATION_MIN_DELTA=6       # New messages before an active session's delta is classified
# SESSIONS_CLASSIFICATION_LOOKBACK="3 days" # Sweep tracks recently-ACTIVE sessions (by synced_at, so resumed
#                                           # old sessions count); NEVER the untouched backlog. Keep > 48h.
# SESSIONS_CLASSIFICATION_CRON="*/30 * * * *"  # Classification sweep cadence
# SESSIONS_SYNTHESIS_CRON="0 13 * * 1"      # Weekly synthesis (default Mondays ~09:00 ET)
# SESSIONS_SYNTHESIS_MODEL=claude-sonnet-5
# One-time historical backfill is bounded + manual (recommended first window: 30 days):
#   curl -XPOST "$BASE/api/sessions/classify/backfill?since=$(date -u -d '30 days ago' +%FT%TZ)"

# AI Features (optional - enables AI-generated outlines and email triage)
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
OUTLINE_CONCURRENCY=5
TRIAGE_CONCURRENCY=5

# Google OAuth (required for google module)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Scopes needed: gmail.readonly, gmail.modify, gmail.labels
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:2529/api/google/auth/callback
# GOOGLE_DISABLE_EMAIL_SYNC=true     # Disable Gmail sync
# GOOGLE_DISABLE_EMAIL_TRIAGE=true   # Disable AI email triage
# GOOGLE_DISABLE_EMAIL_ACTIONS=true  # Kill switch for the executor + digests + alerts
# GOOGLE_DISABLE_EMAIL_ALERTS=true   # Disable only the urgent-alert dispatch
# Comma-separated domains whose senders are treated as team/whitelisted for the
# urgent-alert bar. Empty by default — set to your own domain(s) on the deploy.
# GOOGLE_TEAM_DOMAINS=example.com
# Optional JSON seed file ({ "rules": [...], "topics": [...] }) used to bootstrap
# deterministic triage rules + topics of interest at first boot. When unset, a
# few generic example rules are seeded instead. The DB table is the source of
# truth; this only bootstraps a fresh instance.
# GOOGLE_TRIAGE_SEED_FILE=/path/to/triage-seed.json

# Capture module (POST /api/capture + classification/routing)
# ENABLE_CAPTURE=true
# CAPTURE_DISABLE_CLASSIFICATION=true  # Disable the classify/route sweep
# CAPTURE_CONCURRENCY=3
# CAPTURE_CLASSIFIER_MODEL=claude-haiku-4-5
# tana-local MCP (stray-thought routing; without these, stray thoughts park in awaiting_executor)
# TANA_MCP_URL=http://127.0.0.1:8262/mcp
TANA_MCP_TOKEN=                    # tana-local Personal Access Token
TANA_WORKSPACE_ID=                 # Workspace whose {id}_CAPTURE_INBOX receives stray thoughts

# Chat module (agent via Slack)
# ENABLE_CHAT=true
SLACK_BOT_TOKEN=                   # xoxb-... from OAuth & Permissions
SLACK_APP_TOKEN=                   # xapp-... from Basic Information → App-Level Tokens (needs connections:write scope)
SLACK_SIGNING_SECRET=              # From Basic Information → App Credentials
SLACK_OWNER_USER_ID=               # Slack member ID of the owner (only this user gets responses)
AGENT_REPO_PATH=                   # Path to agent repo clone (contains CLAUDE.md, skills, MCP config)
BOT_USERNAME=                      # Bot display name for chat platforms
CLAUDE_CODE_OAUTH_TOKEN=           # Generated via: claude setup-token (good for ~1 year)
# Live per-turn context — JSON array of commands whose stdout is injected into
# every chat turn (UserPromptSubmit hook). Each element is a command string or
# an argv array; commands run in AGENT_REPO_PATH with a 15s timeout, fail-soft.
# CHAT_CONTEXT_COMMANDS=["status-cli", ["node", "/path/to/dashboard.mjs"]]

# Notify module (notification dispatcher + heartbeat registry)
# ENABLE_NOTIFY=true                 # On by default
# Pushover — interrupt + notice tiers (phone + watch). Copy the token + user key
# from the existing pushover MCP server config (Hari .hari/mcp-proxy.json):
#   PUSHOVER_TOKEN = ${PUSHOVER_TOKEN} arg, PUSHOVER_USER = ${PUSHOVER_USER} arg
PUSHOVER_TOKEN=                      # Pushover application API token
PUSHOVER_USER=                       # Pushover user/group key (recipient)
# Digest tier reuses SLACK_BOT_TOKEN + SLACK_OWNER_USER_ID from the chat module above.
# Manual coverage ledgers (hq-coverage.md, harvest-coverage.md) are read from here;
# defaults to AGENT_REPO_PATH when unset.
# NOTIFY_HARI_REPO_PATH=/home/chris/Hari
# Host disk-health check
# NOTIFY_DISK_PATH=/                 # Filesystem to watch
# NOTIFY_DISK_MIN_FREE_GB=20         # Alert below this many GiB free
# NOTIFY_DISK_MIN_FREE_PCT=8         # Alert below this percent free
# NOTIFY_DISABLE_STALENESS=true      # Skip the daily staleness/host-health check
# NOTIFY_STALENESS_CRON=0 13 * * *   # Daily staleness check (default ~09:00 ET)
# NOTIFY_DIGEST_FLUSH_CRON=0 12,22 * * *  # Digest flush cadence

# Restic Backup (optional - for database backups)
# Requires gcp-service-account.json in apps/server/ (mounted by backup scripts)
# RESTIC_REPOSITORY=gs:bucket-name:/path
# RESTIC_PASSWORD=
