# Server
PORT=2529
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://claude:dev@localhost:2528/claude_assist
# DISABLE_MIGRATIONS=true  # Skip running migrations on startup

# Module enablement (true by default, set to 'false' to disable)
# ENABLE_SESSIONS=true
# ENABLE_GOOGLE=true

# Master sync disable - overrides all individual sync disable flags
# DISABLE_SYNCS=true

# Session scanning (optional)
# SESSIONS_ORIGINAL_CLAUDE_DIR=/Users/<user>/.claude  # Docker path translation
# SESSIONS_MIN_FILE_SIZE=500
# SESSIONS_DISABLE_LOCAL_INGEST=true       # Disable filesystem scanning (push API still works)
# SESSIONS_DISABLE_GENERATE_OUTLINES=true  # Disable AI outline generation
# Suppress automated/noise sessions from ingest by transcript content.
# Newline-separated substrings, appended to built-in defaults (e.g. M87 triage runner).
# SESSIONS_IGNORE_MARKERS="You are triaging a local-first M87 review item.\nAnother marker"

# Session classification (self-improvement loop; needs ANTHROPIC_API_KEY)
# Per-session incremental cursors → append-only Haiku classification events →
# weekly Sonnet synthesis + timeline narrative (delivered via the notify digest).
# SESSIONS_DISABLE_CLASSIFICATION=true      # Disable classification + synthesis
# SESSIONS_CLASSIFICATION_CONCURRENCY=3
# SESSIONS_CLASSIFICATION_MIN_DELTA=6       # New messages before an active session's delta is classified
# SESSIONS_CLASSIFICATION_LOOKBACK="3 days" # Sweep tracks recently-ACTIVE sessions (by synced_at, so resumed
#                                           # old sessions count); NEVER the untouched backlog. Keep > 48h.
# SESSIONS_CLASSIFICATION_CRON="*/30 * * * *"  # Classification sweep cadence
# SESSIONS_SYNTHESIS_CRON="0 13 * * 1"      # Weekly synthesis (default Mondays ~09:00 ET)
# SESSIONS_SYNTHESIS_MODEL=            # Pin a model, overriding the synthesize tier
# One-time historical backfill is bounded + manual (recommended first window: 30 days):
#   curl -XPOST "$BASE/api/sessions/classify/backfill?since=$(date -u -d '30 days ago' +%FT%TZ)"

# Model invoker — the single choke point for metered model calls.
# Every module that needs a model goes through it; this key is the only metered
# credential and nothing else reads it. Unset ⇒ every model-backed feature
# degrades to its deterministic path instead of failing.
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
OUTLINE_CONCURRENCY=5
TRIAGE_CONCURRENCY=5

# Tier → model. A call site names the TIER its work belongs to; these four are
# the only place a model id is configured, so swapping a model is one edit.
# MODEL_TIER_CLASSIFY=                 # Cheap, high-frequency judgment
# MODEL_TIER_EXTRACT=                  # Mechanical structured extraction
# MODEL_TIER_VISION=                   # Images: photos, receipts, label panels
# MODEL_TIER_SYNTHESIZE=               # Long-context judgment and drafting
# JSON price overrides, USD per million tokens, when list prices move:
# MODEL_PRICES={"claude-haiku-4-5":{"input":1,"output":5}}

# Spend controls. The rolling daily ceilings raise ONE human approval per window
# on breach and fail calls transiently — an exhausted budget never gets blamed
# on the work item, and the pipeline resumes once the overage is approved.
# MODEL_DAILY_BUDGET_USD=10
# MODEL_DAILY_BUDGET_TOKENS=5000000
# MODEL_TASK_BUDGETS_USD={"google.triage":2.5}
# MODEL_KILL_SWITCH=true               # Stop ALL metered calls, host stays healthy
# MODEL_MAX_ATTEMPTS=3                 # Transport attempts per call, incl. the first
# MODEL_RETRY_BASE_MS=500              # First backoff delay; doubles with jitter
# MODEL_TIMEOUT_MS=120000              # Wall-clock default; tiers may lower it

# Approvals — the generic human gate. `request()` records and notifies, then
# returns; nothing ever blocks waiting for a person, and an unanswered request
# expires (expiry means no).
# ENABLE_APPROVALS=true
# APPROVAL_EXPIRY_MS=86400000          # Default lifetime of a pending request
# APPROVAL_EXPIRE_CRON="*/15 * * * *"  # Expiry sweep cadence

# Google OAuth (required for google module)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Scopes needed: gmail.readonly, gmail.modify, gmail.labels
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:2529/api/google/auth/callback
# GOOGLE_DISABLE_EMAIL_SYNC=true     # Disable Gmail sync
# GOOGLE_DISABLE_EMAIL_TRIAGE=true   # Disable AI email triage
# GOOGLE_DISABLE_EMAIL_ACTIONS=true  # Kill switch for the executor + digests + alerts
# GOOGLE_DISABLE_EMAIL_ALERTS=true   # Disable only the urgent-alert dispatch
# Comma-separated domains whose senders are treated as team/whitelisted for the
# urgent-alert bar. Empty by default — set to your own domain(s) on the deploy.
# GOOGLE_TEAM_DOMAINS=example.com
# Optional JSON seed file ({ "rules": [...], "topics": [...] }) used to bootstrap
# deterministic triage rules + topics of interest at first boot. When unset, a
# few generic example rules are seeded instead. The DB table is the source of
# truth; this only bootstraps a fresh instance.
# GOOGLE_TRIAGE_SEED_FILE=/path/to/triage-seed.json

# Capture module (POST /api/capture + classification/routing)
# ENABLE_CAPTURE=true
# CAPTURE_DISABLE_CLASSIFICATION=true  # Disable the classify/route sweep
# CAPTURE_CONCURRENCY=3
# CAPTURE_CLASSIFIER_MODEL=          # Pin a model, overriding the classify tier
# tana-local MCP (stray-thought routing; without these, stray thoughts park in awaiting_executor)
# TANA_MCP_URL=http://127.0.0.1:8262/mcp
TANA_MCP_TOKEN=                    # tana-local Personal Access Token
TANA_WORKSPACE_ID=                 # Workspace whose {id}_CAPTURE_INBOX receives stray thoughts

# Kitchen module (consumption journal + inventory — /api/kitchen/*)
# ENABLE_KITCHEN=true
# KITCHEN_DISABLE_ESTIMATION=true    # Disable the scheduled estimation sweep
# KITCHEN_CONCURRENCY=3
# Per-call-site model pins. Unset routes each call to its tier: meal estimation
# and label panels to `vision`, mechanical receipt-line extraction to `extract`.
# KITCHEN_ESTIMATION_MODEL=
# KITCHEN_RECEIPT_MODEL=
# Model for the spawned interactive meal-planning session — an interactive HUMAN
# session under subscription auth, NOT one of the metered models above. Unset ⇒
# the instance-wide SESSION_SPAWN_MODEL applies.
# KITCHEN_PLAN_SESSION_MODEL=opus
# KITCHEN_MAX_PHOTO_BYTES=10485760
# KITCHEN_MAX_PHOTOS=6
# Meal-bank gitsheet read (both optional — unset degrades to recents-only reselect)
# KITCHEN_MEALBANK_REPO_PATH=/path/to/instance/repo
# KITCHEN_MEALBANK_SHEET=meal-bank
# Owner-set daily reference lines (§ Daily targets) — each panel field maps to
# exactly one of {"max": N} (cap) or {"min": N} (floor); unset omits the
# summary's targets block, malformed fails boot loudly. Example values only.
# `sugar_g` (TOTAL sugar) is deliberately NOT targetable — no established
# guideline exists for it, and a borrowed line reads "over" on a day of fruit
# and plain dairy. The sugar ceiling belongs to `added_sugar_g`; 36 g is the
# AHA's stated daily added-sugar limit for men (25 g for women).
# KITCHEN_DAILY_TARGETS={"added_sugar_g":{"max":36},"fiber_g":{"min":42}}
# Strava activity sync (§ Strava activity sync) — all three credentials present
# ⇒ the scheduled sync runs; any absent ⇒ entirely off. The refresh token is a
# FIRST-BOOT SEED only: once kitchen.strava_oauth has a row, the stored
# (rotated) token is authoritative and this value is ignored. Synthetic
# placeholders only — values come from your own Strava API application.
# KITCHEN_STRAVA_CLIENT_ID=00000
# KITCHEN_STRAVA_CLIENT_SECRET=your-strava-client-secret
# KITCHEN_STRAVA_REFRESH_TOKEN=your-strava-refresh-token
# KITCHEN_STRAVA_SYNC_MINUTES=30     # Cadence in minutes (positive integer; malformed fails boot loudly)

# Chat module (agent via Slack)
# ENABLE_CHAT=true
SLACK_BOT_TOKEN=                   # xoxb-... from OAuth & Permissions
SLACK_APP_TOKEN=                   # xapp-... from Basic Information → App-Level Tokens (needs connections:write scope)
SLACK_SIGNING_SECRET=              # From Basic Information → App Credentials
SLACK_OWNER_USER_ID=               # Slack member ID of the owner (only this user gets responses)
AGENT_REPO_PATH=                   # Path to agent repo clone (contains CLAUDE.md, skills, MCP config)
BOT_USERNAME=                      # Bot display name for chat platforms
CLAUDE_CODE_OAUTH_TOKEN=           # Generated via: claude setup-token (good for ~1 year)
# Live per-turn context — JSON array of commands whose stdout is injected into
# every chat turn (UserPromptSubmit hook). Each element is a command string or
# an argv array; commands run in AGENT_REPO_PATH with a 15s timeout, fail-soft.
# CHAT_CONTEXT_COMMANDS=["status-cli", ["node", "/path/to/dashboard.mjs"]]

# Notify module (notification dispatcher + heartbeat registry)
# ENABLE_NOTIFY=true                 # On by default
# Pushover — interrupt + notice tiers (phone + watch). Copy the token + user key
# from your existing pushover MCP server config:
#   PUSHOVER_TOKEN = ${PUSHOVER_TOKEN} arg, PUSHOVER_USER = ${PUSHOVER_USER} arg
PUSHOVER_TOKEN=                      # Pushover application API token
PUSHOVER_USER=                       # Pushover user/group key (recipient)
# Digest tier reuses SLACK_BOT_TOKEN + SLACK_OWNER_USER_ID from the chat module above.
# Manual coverage ledgers (e.g. hq-coverage.md, harvest-coverage.md) are read
# from here; defaults to AGENT_REPO_PATH when unset.
# NOTIFY_AGENT_REPO_PATH=/path/to/agent-repo
# Deprecated alias, still honored with a startup warning:
# NOTIFY_HARI_REPO_PATH=/path/to/agent-repo
# Host disk-health check
# NOTIFY_DISK_PATH=/                 # Filesystem to watch
# NOTIFY_DISK_MIN_FREE_GB=20         # Alert below this many GiB free
# NOTIFY_DISK_MIN_FREE_PCT=8         # Alert below this percent free
# NOTIFY_DISABLE_STALENESS=true      # Skip the daily staleness/host-health check
# NOTIFY_STALENESS_CRON=0 13 * * *   # Daily staleness check (default ~09:00 ET)
# NOTIFY_DIGEST_FLUSH_CRON=0 12,22 * * *  # Digest flush cadence

# Session-spawn module (warm an interactive session + ping the phone with a
# takeover link — the app-initiated gather-and-ping "spawn" half; needs notify).
# ENABLE_SESSION_SPAWN=true            # On by default
# The spawn command as a JSON argv array (same convention as CHAT_CONTEXT_COMMANDS).
# Given a preload prompt appended as a temp-file path in the final argv slot, the
# command warms an RC session and prints a takeover URL to stdout. Unset ⇒ the
# feature is disabled (POST /api/kitchen/plan-session returns 503). The command,
# its working directory, and its auth are all instance data.
# SESSION_SPAWN_CMD=["your-rc-tool", "spawn", "--workspace", "planning", "--preload-file"]
# SESSION_SPAWN_TIMEOUT_MS=120000      # Per-spawn wall-clock bound (fail loud, never hang)
# Model every spawned interactive session runs on (default: opus). Always passed
# explicitly so a warm session never inherits whichever model was last selected
# interactively. An alias tracks the latest model in that tier; a full model name
# pins one. Reaches the command as SESSION_SPAWN_MODEL in its environment.
# SESSION_SPAWN_MODEL=opus
# An individual caller may override it — see KITCHEN_PLAN_SESSION_MODEL.

# Restic Backup (optional - for database backups)
# Requires gcp-service-account.json in apps/server/ (mounted by backup scripts)
# RESTIC_REPOSITORY=gs:bucket-name:/path
# RESTIC_PASSWORD=

# Maximum agent turns per chat query before the SDK aborts (default 30).
# Working sessions that drive CLIs burn a turn per tool round — size to the
# longest workflow the agent should finish.
# CHAT_MAX_TURNS=100
