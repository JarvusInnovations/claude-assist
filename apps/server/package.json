{
  "name": "@jarvus/claude-assist-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pkill -f 'bun.*src/server\\.ts' || true",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "tsc",
    "test": "bun test src",
    "backup": "./bin/backup.sh",
    "backup:init": "./bin/backup-init.sh",
    "backup:list": "./bin/backup-list.sh",
    "backup:dump": "./bin/backup-dump.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.10",
    "pino-pretty": "^13.1.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fastify/env": "^5.0.3",
    "@fastify/static": "^9.0.0",
    "@jarvus/claude-assist-briefing": "workspace:*",
    "@jarvus/claude-assist-capture": "workspace:*",
    "@jarvus/claude-assist-chat": "workspace:*",
    "@jarvus/claude-assist-core": "workspace:*",
    "@jarvus/claude-assist-google": "workspace:*",
    "@jarvus/claude-assist-kitchen": "workspace:*",
    "@jarvus/claude-assist-approvals": "workspace:*",
    "@jarvus/claude-assist-invoker": "workspace:*",
    "@jarvus/claude-assist-ledger": "workspace:*",
    "@jarvus/claude-assist-notify": "workspace:*",
    "@jarvus/claude-assist-pages": "workspace:*",
    "@jarvus/claude-assist-session-spawn": "workspace:*",
    "@jarvus/claude-assist-sessions": "workspace:*",
    "@jarvus/claude-assist-slack-urgency": "workspace:*",
    "@jarvus/claude-assist-training": "workspace:*",
    "fastify": "^5.7.1",
    "fastify-plugin": "^5.1.0",
    "postgres": "^3.4.8"
  }
}
