#!/usr/bin/env bash
set -euo pipefail

SERVER="${CLAUDE_ASSIST_SERVER:-http://localhost:2529}"
ACCOUNT="" FULL="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --account) ACCOUNT="$2"; shift 2 ;;
    --full)    FULL="true"; shift; [[ ${1:-} == "true" ]] && shift ;;
    *)
      echo "Usage: sync-emails [--account ID] [--full]"
      exit 1
      ;;
  esac
done

BODY=$(jq -n \
  --arg account "$ACCOUNT" --argjson full "$FULL" \
  '{}
   + (if $account != "" then {account: $account} else {} end)
   + (if $full then {full: true} else {} end)')

exec curl -sf -X POST -H "Content-Type: application/json" -d "$BODY" "${SERVER}/api/google/emails/sync" | jq .
