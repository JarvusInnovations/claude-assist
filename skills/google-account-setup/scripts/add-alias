#!/usr/bin/env bash
set -euo pipefail

SERVER="${CLAUDE_ASSIST_SERVER:-http://localhost:2529}"

if [[ $# -lt 1 ]]; then
  echo "Usage: add-alias <account-id> --alias NAME [--not-owner]"
  exit 1
fi

ID="$1"; shift
ALIAS="" IS_OWNER="true"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --alias)     ALIAS="$2"; shift 2 ;;
    --not-owner) IS_OWNER="false"; shift; [[ ${1:-} == "true" ]] && shift ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

if [[ -z "$ALIAS" ]]; then
  echo "Usage: add-alias <account-id> --alias NAME [--not-owner]"
  exit 1
fi

BODY=$(jq -n --arg alias "$ALIAS" --argjson owner "$IS_OWNER" '{alias: $alias, is_owner: $owner}')

exec curl -sf -X POST -H "Content-Type: application/json" -d "$BODY" "${SERVER}/api/google/accounts/${ID}/aliases" | jq .
