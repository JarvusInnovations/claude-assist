#!/usr/bin/env bash
set -euo pipefail

SERVER="${CLAUDE_ASSIST_SERVER:-http://localhost:2529}"

if [[ $# -lt 1 ]]; then
  echo "Usage: update-account <account-id> [--sync-start-date DATE] [--label-prefix PREFIX] [--triage-instructions TEXT]"
  exit 1
fi

ID="$1"; shift
SYNC_DATE="" LABEL_PREFIX="" TRIAGE_INSTRUCTIONS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --sync-start-date)      SYNC_DATE="$2"; shift 2 ;;
    --label-prefix)         LABEL_PREFIX="$2"; shift 2 ;;
    --triage-instructions)  TRIAGE_INSTRUCTIONS="$2"; shift 2 ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

BODY=$(jq -n \
  --arg sd "$SYNC_DATE" --arg lp "$LABEL_PREFIX" --arg ti "$TRIAGE_INSTRUCTIONS" \
  '{}
   + (if $sd != "" then {email_sync_start_date: $sd} else {} end)
   + (if $lp != "" then {email_label_prefix: $lp} else {} end)
   + (if $ti != "" then {email_triage_instructions: $ti} else {} end)')

exec curl -sf -X PATCH -H "Content-Type: application/json" -d "$BODY" "${SERVER}/api/google/accounts/${ID}" | jq .
