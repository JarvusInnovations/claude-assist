#!/usr/bin/env bash
set -euo pipefail

SERVER="${CLAUDE_ASSIST_SERVER:-http://localhost:2529}"

ID=""
BEFORE=""
AFTER=""
GROUP=""
PROJECT=""
MIN_USER_MESSAGES=""
RAW=""
INCLUDE_TOOLS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --before) BEFORE="$2"; shift 2 ;;
    --after) AFTER="$2"; shift 2 ;;
    --group) GROUP="$2"; shift 2 ;;
    --project) PROJECT="$2"; shift 2 ;;
    --min-user-messages) MIN_USER_MESSAGES="$2"; [[ "$MIN_USER_MESSAGES" =~ ^[0-9]+$ ]] || { echo "min-user-messages must be a non-negative integer"; exit 1; }; shift 2 ;;
    --raw) RAW="true"; shift; [[ ${1:-} == "true" ]] && shift ;;
    --include-tools) INCLUDE_TOOLS="true"; shift ;;
    -*) echo "Unknown option: $1"; exit 1 ;;
    *) ID="$1"; shift ;;
  esac
done

if [[ -z "$ID" ]]; then
  # Global transcript endpoint — requires before and after
  if [[ -z "$BEFORE" || -z "$AFTER" ]]; then
    echo "Usage: transcript [session-id] [--before DATE] [--after DATE] [--group project|time] [--project PATH]"
    echo ""
    echo "Without session-id, --before and --after are required for cross-session transcript."
    exit 1
  fi
  # Use curl -G --data-urlencode for proper encoding of all params (especially project paths)
  ARGS=(-sf -G "${SERVER}/api/sessions/transcript"
    --data-urlencode "after=${AFTER}"
    --data-urlencode "before=${BEFORE}")
  [[ -n "$GROUP" ]] && ARGS+=(--data-urlencode "group=${GROUP}")
  [[ -n "$PROJECT" ]] && ARGS+=(--data-urlencode "project=${PROJECT}")
  [[ -n "$MIN_USER_MESSAGES" ]] && ARGS+=(--data-urlencode "min_user_messages=${MIN_USER_MESSAGES}")
  [[ -n "$INCLUDE_TOOLS" ]] && ARGS+=(--data-urlencode "include_tools=true")
  exec curl "${ARGS[@]}"
else
  # Per-session transcript endpoint
  ARGS=(-sf -G "${SERVER}/api/sessions/${ID}/transcript")
  [[ -n "$AFTER" ]] && ARGS+=(--data-urlencode "after=${AFTER}")
  [[ -n "$BEFORE" ]] && ARGS+=(--data-urlencode "before=${BEFORE}")
  [[ -n "$RAW" ]] && ARGS+=(--data-urlencode "with_raw_messages=true")
  [[ -n "$INCLUDE_TOOLS" ]] && ARGS+=(--data-urlencode "include_tools=true")
  exec curl "${ARGS[@]}"
fi
