#!/usr/bin/env bash
set -euo pipefail

SERVER="${CLAUDE_ASSIST_SERVER:-http://localhost:2529}"
CURL_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --query)   CURL_ARGS+=(--data-urlencode "search=$2"); shift 2 ;;
    --days)    CURL_ARGS+=(--data-urlencode "days=$2"); shift 2 ;;
    --project) CURL_ARGS+=(--data-urlencode "project=$2"); shift 2 ;;
    --tools)   CURL_ARGS+=(--data-urlencode "tools=$2"); shift 2 ;;
    --machine) CURL_ARGS+=(--data-urlencode "machine=$2"); shift 2 ;;
    --since)   CURL_ARGS+=(--data-urlencode "since=$2"); shift 2 ;;
    --until)   CURL_ARGS+=(--data-urlencode "until=$2"); shift 2 ;;
    --forever)            CURL_ARGS+=(--data-urlencode "forever=true"); shift; [[ ${1:-} == "true" ]] && shift ;;
    --min-user-messages)  CURL_ARGS+=(--data-urlencode "min_user_messages=$2"); shift 2 ;;
    --limit)              CURL_ARGS+=(--data-urlencode "limit=$2"); shift 2 ;;
    --offset)             CURL_ARGS+=(--data-urlencode "offset=$2"); shift 2 ;;
    *)
      echo "Usage: search [--query TEXT] [--days N] [--project PATH] [--tools TOOLS]"
      echo "              [--machine ID] [--since DATE] [--until DATE] [--forever]"
      echo "              [--min-user-messages N] [--limit N] [--offset N]"
      exit 1
      ;;
  esac
done

exec curl -sf -G ${CURL_ARGS[@]+"${CURL_ARGS[@]}"} "${SERVER}/api/sessions" | jq .
