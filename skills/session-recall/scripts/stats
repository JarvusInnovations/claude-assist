#!/usr/bin/env bash
set -euo pipefail

SERVER="${CLAUDE_ASSIST_SERVER:-http://localhost:2529}"
PARAMS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --days)    PARAMS+="&days=$2"; shift 2 ;;
    --machine) PARAMS+="&machine=$2"; shift 2 ;;
    *)
      echo "Usage: stats [--days N] [--machine ID]"
      exit 1
      ;;
  esac
done

PARAMS="${PARAMS:+?${PARAMS:1}}"

exec curl -sf "${SERVER}/api/sessions/stats${PARAMS}" | jq .
